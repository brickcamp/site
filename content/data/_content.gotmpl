{{ $any := "__any" }}

{{/* Collect the type-scoped lookups per filter. Values are no longer part of
     the path: every value is carried inside the CSV rows and filtered on the
     client, so a fixed set of files covers any value (listed or not). */}}
{{ $combinations := newScratch }}
{{ range $f := hugo.Data.entries.filters }}
  {{/* `from` is read on both sides of the seam: _partials/scopes/getCatalog
       keeps "size" out of the scopes and lets "parts" through as the part-list
       scope, which assets/js/home/scope.js then recognises by the same value. */}}
  {{ if not (in (slice "tags" "size" "parts") $f.from) }}
    {{ errorf "filter %q: unknown from %q" $f.slug $f.from }}
  {{ end }}

  {{/* Only tag filters are served from /data/filtered/: size is filtered on the
       client against the size column, and parts come from /parts/<id>/. */}}
  {{ if ne $f.from "tags" }}{{ continue }}{{ end }}

  {{ $basePath := print "filtered/" $f.slug }}

  {{/* Any Type */}}
  {{ $combinations.Add (print $basePath "-" $any "-" $any) (dict
    "base" $f.slug
  )}}

  {{/* Listed Types — the only ones there are: an unlisted type fails the
       build in _partials/tags/getSegments. */}}
  {{ range $t := $f.types }}
    {{ $combinations.Add (print $basePath "-" $t.slug "-" $any) (dict
      "base" $f.slug
      "type" $t.slug
    )}}
  {{ end }}
{{ end }}

{{/* Unfiltered + Any Type: no base, so every tag passes and no values column. */}}
{{ $combinations.Add (print "filtered/" $any "-" $any "-" $any) dict }}

{{/* Create lookup file for each combination */}}
{{ range $path, $filter := $combinations.Values }}
  {{ $page := dict
    "title"   $path
    "kind"    "page"
    "path"    $path
    "outputs" (slice "csv")
    "layout"  "filtered"
    "params"  (dict "filter" $filter)
    "sitemap" (dict "disable" true)
  }}
  {{ $.AddPage $page }}
{{ end }}

{{/* Publish the scope catalog for the client (see _partials/scopes/getCatalog) */}}
{{ $.AddPage (dict
  "title"   "scopes"
  "kind"    "page"
  "path"    "scopes"
  "outputs" (slice "json")
  "layout"  "scopes"
  "sitemap" (dict "disable" true)
)}}

{{/* Create lookup file for each sort order */}}
{{ range $sorting := hugo.Data.entries.sortings.options }}
  {{ $page := dict
    "title"    $sorting.title
    "kind"     "page"
    "path"     (print "sorted/" $sorting.slug)
    "outputs"  (slice "csv")
    "layout"   "sorted"
    "params"   (dict "sorting" $sorting)
    "sitemap"  (dict "disable" true)
  }}
  {{ if not $sorting.nocsv }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
