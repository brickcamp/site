{{ $any  := "__any" }}
{{ $else := "__else" }}

{{/* Collect the type-scoped lookups per filter. Values are no longer part of
     the path: every value is carried inside the CSV rows and filtered on the
     client, so a fixed set of files covers any value (listed or not). */}}
{{ $combinations := newScratch }}
{{ range $f := $.Site.Data.entries.filters }}
  {{ $basePath := print "filtered/" $f.slug }}

  {{/* Any Type */}}
  {{ $combinations.Add (print $basePath "-" $any "-" $any) (dict
    "from" $f.from
    "base" $f.slug
  )}}

  {{/* Listed Types */}}
  {{ $types := slice }}
  {{ range $t := $f.types }}
    {{ $combinations.Add (print $basePath "-" $t.slug "-" $any) (dict
      "from" $f.from
      "base" $f.slug
      "type" $t.slug
    )}}
    {{ $types = $types | append $t.slug }}
  {{ end }}

  {{/* Unlisted Type */}}
  {{ with $types }}
    {{ $combinations.Add (print $basePath "-" $else "-" $any) (dict
      "from"     $f.from
      "base"     $f.slug
      "notTypes" $types
    )}}
  {{ end }}
{{ end }}

{{/* Unfiltered + Any Type */}}
{{ $combinations.Add (print "filtered/" $any "-" $any "-" $any) (dict "from" "tags" )}}

{{/* Create lookup file for each combination */}}
{{ range $path, $filter := $combinations.Values }}
  {{ $page := dict
    "title"   $path
    "kind"    "page"
    "path"    $path
    "outputs" (slice "csv")
    "layout"  "filtered"
    "params"  (dict "filter" $filter)
    "sitemap" (dict "disable" true)
  }}
  {{ $.AddPage $page }}
{{ end }}

{{/* Publish the scope catalog for the client (see _partials/scopes/getCatalog) */}}
{{ $.AddPage (dict
  "title"   "scopes"
  "kind"    "page"
  "path"    "scopes"
  "outputs" (slice "json")
  "layout"  "scopes"
  "sitemap" (dict "disable" true)
)}}

{{/* Create lookup file for each sort order */}}
{{ range $sorting := $.Site.Data.entries.sortings.options }}
  {{ $page := dict
    "title"    $sorting.title
    "kind"     "page"
    "path"     (print "sorted/" $sorting.slug)
    "outputs"  (slice "csv")
    "layout"   "sorted"
    "params"   (dict "sorting" $sorting)
    "sitemap"  (dict "disable" true)
  }}
  {{ if not $sorting.nocsv }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
